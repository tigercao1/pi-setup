{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "vercel-ai-gateway",
  "defaultModel": "anthropic/claude-sonnet-5.5",
  "defaultThinkingLevel": "medium",
  "extensions": [
    "+extensions/ding/index.ts"
  ],
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ],
  "hideThinkingBlock": true,
  "contextWatcher": {
    "enabled": true,
    "warnTokens": 200000,
    "suggestTokens": 250000
  },
  "leadOutputCap": {
    "enabled": true,
    "thresholdBytes": 8192,
    "exemptTools": [],
    "secretTools": [],
    "retentionDays": 7
  },
  "leadTrial": {
    "enabled": true,
    "until": "2026-11-05",
    "models": [
      "anthropic/claude-sonnet-5.5",
      "anthropic/claude-opus-5.5"
    ]
  },
  "team": {
    "profiles": {
      "coder": {
        "model": "anthropic/claude-opus-5.5",
        "provider": "vercel-ai-gateway"
      },
      "pr-author": {
        "model": "anthropic/claude-opus-5.5",
        "provider": "vercel-ai-gateway"
      },
      "tester": {
        "model": "anthropic/claude-opus-5.5",
        "provider": "vercel-ai-gateway"
      }
    }
  }
}
