#!/bin/bash
# Stage one local skill or extension in the company registry's hosted-package layout, diff it
# against the registry's latest published copy, then hand it to the registry CLI.
#
#   publish-package skill/<name> [--dry-run] [--yes]
#   publish-package extension/<name> [--dry-run] [--yes]
#
# The source is <agent dir>/<skills|extensions>/<name>, else <dir>/<name> for each directory listed
# under "skills" / "extensions" in settings.json (relative to the agent dir).
# Metadata comes from <skill|extension dir>/registry.json:
#   { "name": "...", "version": "x.y.z", "author": "...", "description": "...", "tags": [...],
#     "license": "UNLICENSED", "requires": "markdown for the README's Requires section",
#     "readme": "relative path to a README to publish instead of the generated one",
#     "exclude": ["rsync patterns left out of the package"],
#     "scripts": { "package.json scripts, merged over the local package.json's" } }
# A skill whose "## <name>" section exists in the company layer's rules/skill-overlays.md gets that
# section appended to the staged SKILL.md under "## Company specifics". An extension's imports of
# ../_shared/* are vendored into the package as _shared/*, transitively, with specifiers rewritten.
# A local README gets the registry title and Install section; without one, a README is generated.
# Registry coordinates (COMPANY_REGISTRY_REPO, COMPANY_REGISTRY_CLI, COMPANY_REGISTRY_MANIFEST) come
# from company.env here, then ../homebase/company.env; environment variables override both. PUBLISH_CLI overrides the CLI.
set -euo pipefail

AGENT_DIR="${PI_AGENT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
HOST_PACKAGES='["@earendil-works/pi-ai","@earendil-works/pi-agent-core","@earendil-works/pi-coding-agent","@earendil-works/pi-tui","typebox"]'

usage() { sed -n '5,6p' "$0" | sed 's/^# *//' >&2; exit 2; }
die() { echo "publish-package: $*" >&2; exit 1; }
heading() { printf '\n== %s\n' "$*"; }

TARGET=""
DRY_RUN=0
ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --yes) ASSUME_YES=1 ;;
    -h | --help) usage ;;
    -*) die "unknown flag $arg" ;;
    *) [ -z "$TARGET" ] && TARGET="$arg" || usage ;;
  esac
done
[ -n "$TARGET" ] || usage

KIND="${TARGET%%/*}"
LOCAL_NAME="${TARGET#*/}"
case "$KIND" in
  skill | skills) KIND=skill; KIND_DIR=skills; TYPE_DIR="registry/pi/skills" ;;
  extension | extensions) KIND=extension; KIND_DIR=extensions; TYPE_DIR="registry/pi/extensions" ;;
  *) usage ;;
esac
command -v jq >/dev/null || die "needs jq"

settings_dirs() {
  local entry
  [ -f "$AGENT_DIR/settings.json" ] || return 0
  while IFS= read -r entry; do
    case "$entry" in "" | -* | '!'*) continue ;; esac
    entry="${entry#+}"
    case "$entry" in
      "~/"*) entry="$HOME/${entry#\~/}" ;;
      /*) ;;
      *) entry="$AGENT_DIR/$entry" ;;
    esac
    [ -d "$entry" ] && (cd "$entry" && pwd)
  done < <(jq -r --arg k "$1" '(.[$k] // [])[] | select(type == "string")' "$AGENT_DIR/settings.json")
  return 0
}

SEARCH_DIRS=("$AGENT_DIR/$KIND_DIR")
while IFS= read -r dir; do SEARCH_DIRS+=("$dir"); done < <(settings_dirs "$KIND_DIR")
SRC=""
SRC_ROOT=""
for dir in "${SEARCH_DIRS[@]}"; do
  if [ -d "$dir/$LOCAL_NAME" ]; then
    SRC="$(cd "$dir/$LOCAL_NAME" && pwd)"
    SRC_ROOT="$dir"
    break
  fi
done
[ -n "$SRC" ] || die "$LOCAL_NAME not found in: ${SEARCH_DIRS[*]}"

COMPANY_DIR=""
LAYER_CANDIDATES=()
[ "$SRC_ROOT" != "$AGENT_DIR/$KIND_DIR" ] && LAYER_CANDIDATES+=("$SRC_ROOT/..")
while IFS= read -r dir; do LAYER_CANDIDATES+=("$dir/.."); done < <(settings_dirs skills)
LAYER_CANDIDATES+=("$AGENT_DIR/../homebase")
for dir in "${LAYER_CANDIDATES[@]}"; do
  if [ -f "$dir/rules/skill-overlays.md" ]; then
    COMPANY_DIR="$(cd "$dir" && pwd)"
    break
  fi
done
SIDECAR="$SRC/registry.json"
[ -f "$SIDECAR" ] || die "$SIDECAR missing; it holds name, version, author, description, tags"

COMPANY_KEYS=(COMPANY_LAYER_REPO COMPANY_REGISTRY_REPO COMPANY_REGISTRY_CLI COMPANY_REGISTRY_INSTALL COMPANY_REGISTRY_MANIFEST)
COMPANY_ENV_OVERRIDES=()
for key in "${COMPANY_KEYS[@]}"; do
  if [ -n "${!key+x}" ]; then COMPANY_ENV_OVERRIDES+=("$key=${!key}"); fi
done
load_company_env() {
  local file pair key
  for file in "$AGENT_DIR/company.env" "$AGENT_DIR/../homebase/company.env"; do
    if [ -f "$file" ]; then
      set -a
      # shellcheck disable=SC1090
      . "$file"
      set +a
    fi
  done
  for pair in "${COMPANY_ENV_OVERRIDES[@]+"${COMPANY_ENV_OVERRIDES[@]}"}"; do
    printf -v "${pair%%=*}" '%s' "${pair#*=}"
  done
  for key in "${COMPANY_KEYS[@]}"; do
    printf -v "$key" '%s' "${!key-}"
  done
}
load_company_env
REPO="${COMPANY_REGISTRY_REPO:-}"
CLI="${PUBLISH_CLI:-${COMPANY_REGISTRY_CLI:-}}"
[ -n "$REPO" ] || die "COMPANY_REGISTRY_REPO is not set (../homebase/company.env or environment)"
[ -n "$CLI" ] || die "COMPANY_REGISTRY_CLI is not set (../homebase/company.env or environment)"
MANIFEST="${COMPANY_REGISTRY_MANIFEST:-}"
[ -n "$MANIFEST" ] || die "COMPANY_REGISTRY_MANIFEST is not set (../homebase/company.env or environment)"
for tool in jq gh rsync diff tar python3; do command -v "$tool" >/dev/null || die "needs $tool"; done

meta() { jq -r --arg k "$1" '.[$k] // empty' "$SIDECAR"; }
NAME="$(meta name)"
VERSION="$(meta version)"
AUTHOR="$(meta author)"
DESCRIPTION="$(meta description)"
LICENSE="$(meta license)"
LICENSE="${LICENSE:-UNLICENSED}"
REQUIRES="$(meta requires)"
README_SRC="$(meta readme)"

PROBLEMS=()
[[ "$NAME" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] && [ "${#NAME}" -le 64 ] || PROBLEMS+=("name '$NAME' must be lowercase kebab-case, at most 64 chars")
[ "$KIND" = extension ] && [[ "$NAME" != pi-* ]] && PROBLEMS+=("extension registry names start with pi- (got '$NAME')")
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || PROBLEMS+=("version '$VERSION' is not semver")
[ -n "$AUTHOR" ] || PROBLEMS+=("author is required")
[ -n "$DESCRIPTION" ] && [ "${#DESCRIPTION}" -le 300 ] || PROBLEMS+=("description is required, at most 300 chars")
jq -e '.tags as $t | ($t | type == "array") and ($t | length >= 1 and length <= 10) and (($t | unique | length) == ($t | length))
  and all($t[]; test("^[a-z0-9]+(-[a-z0-9]+)*$") and length <= 32)' "$SIDECAR" >/dev/null ||
  PROBLEMS+=("tags must be 1-10 unique lowercase kebab-case strings of at most 32 chars")
LINKS="$(cd "$SRC" && find . -type l -not -path './node_modules*' | sed 's|^\./||')"
[ -z "$LINKS" ] || PROBLEMS+=("symlinks are not allowed in a hosted package: $LINKS")
if [ "${#PROBLEMS[@]}" -gt 0 ]; then
  printf 'publish-package: %s\n' "${PROBLEMS[@]}" >&2
  exit 1
fi

append_overlay() {
  python3 - "$@" <<'PY'
import sys
overlays, name, skill = sys.argv[1:4]
section, inside, fence = [], False, False
for line in open(overlays, encoding="utf-8").read().splitlines():
    if line.startswith("```"):
        fence = not fence
    if not fence and line.startswith("## "):
        inside = line[3:].strip() == name
        continue
    if inside:
        section.append(line)
body = "\n".join(section).strip("\n")
if body.strip():
    text = open(skill, encoding="utf-8").read().rstrip("\n")
    open(skill, "w", encoding="utf-8").write(f"{text}\n\n## Company specifics\n\n{body}\n")
    print(f"publish-package: appended '## {name}' from {overlays} to SKILL.md as '## Company specifics'")
PY
}

vendor_shared() {
  python3 - "$@" <<'PY'
import json, os, re, shutil, sys
src, stage, shared, builtins = sys.argv[1], sys.argv[2], os.path.realpath(sys.argv[3]), set(json.loads(sys.argv[4]))
src = os.path.realpath(src)
spec_re = re.compile(r"""(\b(?:from|import)\s*\(?\s*)(["'])([^"'\n]+)\2""")
code_ext = (".ts", ".mts", ".cts", ".js", ".mjs", ".cjs", ".tsx", ".jsx")
vendor = os.path.join(stage, "_shared")
if os.path.exists(vendor):
    sys.exit(f"publish-package: {src} already has a _shared/ entry; cannot vendor ../_shared into it")

def within(path, root):
    return path == root or path.startswith(root + os.sep)

queue = []
for root, dirs, files in os.walk(stage):
    dirs[:] = [d for d in dirs if d != "node_modules"]
    for f in files:
        if f.endswith(code_ext):
            staged = os.path.join(root, f)
            queue.append((staged, os.path.join(src, os.path.relpath(staged, stage))))

bare, seen = set(), set()
while queue:
    staged, origin = queue.pop()
    if staged in seen:
        continue
    seen.add(staged)
    text = open(staged, encoding="utf-8").read()

    def rewrite(m):
        spec = m.group(3)
        if not spec.startswith("."):
            if not spec.startswith("node:") and spec.split("/")[0] not in builtins:
                parts = spec.split("/")
                bare.add("/".join(parts[:2]) if spec.startswith("@") else parts[0])
            return m.group(0)
        target = os.path.realpath(os.path.join(os.path.dirname(origin), spec))
        if within(target, src):
            return m.group(0)
        if not within(target, shared):
            sys.exit(f"publish-package: {origin} imports {spec}, outside the extension and ../_shared")
        if not os.path.isfile(target):
            sys.exit(f"publish-package: {origin} imports {spec}, which does not exist")
        dest = os.path.join(vendor, os.path.relpath(target, shared))
        if not os.path.exists(dest):
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.copy2(target, dest)
            print(f"publish-package: vendored ../_shared/{os.path.relpath(target, shared)}", file=sys.stderr)
        queue.append((dest, target))
        new = os.path.relpath(dest, os.path.dirname(staged))
        if not new.startswith("."):
            new = "./" + new
        return f"{m.group(1)}{m.group(2)}{new}{m.group(2)}"

    out = spec_re.sub(rewrite, text)
    if out != text:
        open(staged, "w", encoding="utf-8").write(out)
print(json.dumps(sorted(bare)))
PY
}

registry_readme() {
  python3 - "$@" <<'PY'
import sys
path, name, install = sys.argv[1:4]
lines = open(path, encoding="utf-8").read().rstrip("\n").split("\n")
fence, title, first_h2, has_install = False, None, None, False
for i, line in enumerate(lines):
    if line.startswith("```"):
        fence = not fence
    if fence:
        continue
    if title is None and line.startswith("# "):
        title = i
    elif line.startswith("## "):
        first_h2 = i if first_h2 is None else first_h2
        has_install = has_install or line.strip() == "## Install"
if title is None:
    lines[:0] = [f"# {name}", ""]
    first_h2 = None if first_h2 is None else first_h2 + 2
else:
    lines[title] = f"# {name}"
if not has_install:
    block = ["## Install", ""] + install.rstrip("\n").split("\n") + [""]
    if first_h2 is None:
        lines += [""] + block[:-1]
    else:
        lines[first_h2:first_h2] = block
open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY
}

WORK="$(mktemp -d "${TMPDIR:-/tmp}/publish-package.XXXXXX")"
STAGE="$WORK/staged"
PUBLISHED="$WORK/published"
mkdir -p "$STAGE"

EXCLUDES=(--exclude registry.json --exclude node_modules --exclude .git/ --exclude .DS_Store
  --exclude __pycache__/ --exclude '*.pyc' --exclude dist/)
while IFS= read -r pattern; do
  [ -n "$pattern" ] && EXCLUDES+=(--exclude "$pattern")
done < <(jq -r '(.exclude // [])[]' "$SIDECAR")
[ -n "$README_SRC" ] && EXCLUDES+=(--exclude "/$README_SRC")

SHARED_DIR="$(dirname "$SRC")/_shared"
SHARED_PKG='{}'
IMPORTS='[]'
if [ "$KIND" = skill ]; then
  mkdir -p "$STAGE/skills/$LOCAL_NAME"
  rsync -a "${EXCLUDES[@]}" "$SRC/" "$STAGE/skills/$LOCAL_NAME/"
  PI_FIELD='{"skills": ["./skills"]}'
  LOCAL_PKG='{}'
  if [ -n "$COMPANY_DIR" ]; then
    append_overlay "$COMPANY_DIR/rules/skill-overlays.md" "$LOCAL_NAME" "$STAGE/skills/$LOCAL_NAME/SKILL.md"
  fi
else
  rsync -a "${EXCLUDES[@]}" --exclude /package.json "$SRC/" "$STAGE/"
  if [ -f "$SRC/package.json" ]; then LOCAL_PKG="$(cat "$SRC/package.json")"; else LOCAL_PKG='{}'; fi
  [ -f "$SHARED_DIR/package.json" ] && SHARED_PKG="$(cat "$SHARED_DIR/package.json")"
  PI_FIELD="$(jq -c '.pi // {"extensions": ["./index.ts"]}' <<<"$LOCAL_PKG")"
  IMPORTS="$(vendor_shared "$SRC" "$STAGE" "$SHARED_DIR" "$(node -p 'JSON.stringify(require("module").builtinModules)' 2>/dev/null || echo '[]')")"
fi

jq -n --arg name "$NAME" --arg version "$VERSION" --arg description "$DESCRIPTION" \
  --arg license "$LICENSE" --arg kind "$KIND" --argjson pi "$PI_FIELD" \
  --argjson local "$LOCAL_PKG" --argjson shared "$SHARED_PKG" --argjson imports "$IMPORTS" \
  --argjson host "$HOST_PACKAGES" --slurpfile meta "$SIDECAR" '
  def sorted: to_entries | sort_by(.key) | from_entries;
  (($shared.dependencies // {}) + ($local.dependencies // {})) as $known
  | ($local.dependencies // {}) as $deps
  | ($deps | with_entries(select(.key as $k | $host | index($k)))) as $hostDeps
  | (($deps | with_entries(select(.key as $k | $host | index($k) | not)))
     + ([$imports[] | select(. as $k | $host | index($k) | not) | {key: ., value: $known[.]}]
        | map(select(.value != null)) | from_entries)) as $ownDeps
  | ([$imports[] | select(. as $k | $host | index($k)) | {key: ., value: "*"}] | from_entries) as $hostImports
  | (($local.scripts // {}) + ($meta[0].scripts // {})) as $scripts
  | {name: $name, version: $version, description: $description, type: "module",
     keywords: (["pi-package"] + $meta[0].tags), license: $license, pi: $pi}
  + (if ($scripts | length) > 0 then {scripts: $scripts} else {} end)
  + (if ($ownDeps | length) > 0 then {dependencies: ($ownDeps | sorted)} else {} end)
  + (if $kind == "extension" then
       {peerDependencies: ({"@earendil-works/pi-coding-agent": "*"} + $hostImports + ($hostDeps | map_values("*")) + ($local.peerDependencies // {}) | sorted),
        devDependencies: ({"@earendil-works/pi-coding-agent": "*"} + $hostImports + ($hostDeps | map_values("*")) + ($local.devDependencies // {}) | sorted)}
     else {} end)
' >"$STAGE/package.json"
UNDECLARED="$(jq -r --argjson imports "$IMPORTS" --argjson host "$HOST_PACKAGES" \
  '$imports - $host - ((.dependencies // {}) | keys) | .[]' "$STAGE/package.json")"
[ -z "$UNDECLARED" ] || die "imports with no version in $SRC/package.json or $SHARED_DIR/package.json: $UNDECLARED"

jq -n --arg type "$KIND" --arg license "$LICENSE" --slurpfile meta "$SIDECAR" '
  $meta[0] as $m
  | {name: $m.name, version: $m.version, author: $m.author, description: $m.description,
     type: $type, tags: $m.tags, license: $license, hosted: true}
' >"$STAGE/$MANIFEST"

printf 'node_modules/\ndist/\n' >"$STAGE/.gitignore"

install_text() {
  printf '```bash\n%s add %s\n```\n\n' "${COMPANY_REGISTRY_CLI:-$CLI}" "$NAME"
  if [ "$KIND" = skill ]; then
    printf 'Restart pi, or run `/reload`. The agent loads the skill when a task matches its description, or run\n`/skill:%s` to load it yourself.\n' "$LOCAL_NAME"
  else
    printf 'Restart pi, or run `/reload`.\n'
  fi
}

if [ -n "$README_SRC" ]; then
  [ -f "$SRC/$README_SRC" ] || die "readme $SRC/$README_SRC not found"
  cp "$SRC/$README_SRC" "$STAGE/README.md"
fi
if [ -f "$STAGE/README.md" ]; then
  INSTALL_TEXT="$(install_text)"
  registry_readme "$STAGE/README.md" "$NAME" "$INSTALL_TEXT"
else
  {
    printf '# %s\n\n%s\n\n## Install\n\n' "$NAME" "$DESCRIPTION"
    install_text
    [ -n "$REQUIRES" ] && printf '\n## Requires\n\n%s\n' "$REQUIRES"
  } >"$STAGE/README.md"
fi

LAYER_NAME="$(basename "${COMPANY_DIR:-$AGENT_DIR/../homebase}")"
LEAKS="$(cd "$STAGE" && grep -rnE "\.pi/$LAYER_NAME|\.pi/agent/skills/|tiger-voice|/Users/[A-Za-z0-9._-]+/" . || true)"
if [ -n "$LEAKS" ]; then
  printf '%s\n' "$LEAKS" | sed 's/^/  /' >&2
  die "staged files reference paths only this machine has (listed above); registry users do not have them. Staged files left in $WORK"
fi

heading "staged $KIND $LOCAL_NAME as $NAME@$VERSION in $STAGE"
(cd "$STAGE" && find . -not -type d | sed 's|^\./||' | sort | while IFS= read -r f; do
  printf '  %7s  %s\n' "$(wc -c <"$f" | tr -d ' ')" "$f"
done)

heading "registry: $REPO"
LATEST_TAG="$(gh api "repos/$REPO/git/matching-refs/tags/$NAME@" --jq '.[].ref' 2>/dev/null |
  sed 's|^refs/tags/||' | grep -E "^$NAME@[0-9]" | sort -t@ -k2 -V | tail -1 || true)"
DEFAULT_BRANCH="$(gh api "repos/$REPO" --jq .default_branch)"
MAIN_TREE="$(gh api "repos/$REPO/git/trees/$DEFAULT_BRANCH:$TYPE_DIR/$NAME" --jq .sha 2>/dev/null || true)"
TAG_TREE=""
[ -n "$LATEST_TAG" ] && TAG_TREE="$(gh api "repos/$REPO/git/trees/$LATEST_TAG:$TYPE_DIR/$NAME" --jq .sha 2>/dev/null || true)"

COMPARE_REF=""
if [ -n "$LATEST_TAG" ]; then
  echo "  latest release tag: $LATEST_TAG"
  COMPARE_REF="$LATEST_TAG"
  if [ -n "$MAIN_TREE" ] && [ "$MAIN_TREE" != "$TAG_TREE" ]; then
    echo "  WARNING: $DEFAULT_BRANCH differs from $LATEST_TAG for this package; diffing against $DEFAULT_BRANCH"
    COMPARE_REF="$DEFAULT_BRANCH"
  fi
elif [ -n "$MAIN_TREE" ]; then
  echo "  no release tag yet; diffing against $DEFAULT_BRANCH"
  COMPARE_REF="$DEFAULT_BRANCH"
else
  echo "  not in the registry yet: this publish adds it"
fi

OPEN_PRS="$(gh pr list -R "$REPO" --state open --search "$NAME in:title" \
  --json number,title,author,headRefName --jq '.[] | "  #\(.number) \(.title) (\(.author.login), \(.headRefName))"' 2>/dev/null || true)"
if [ -n "$OPEN_PRS" ]; then
  echo "  open pull requests mentioning $NAME (someone else may be changing it):"
  echo "$OPEN_PRS"
fi

PUBLISHED_VERSION=""
DIFF_STATUS=1
if [ -n "$COMPARE_REF" ]; then
  mkdir -p "$WORK/tarball" "$PUBLISHED"
  gh api "repos/$REPO/tarball/$COMPARE_REF" >"$WORK/tarball.tgz"
  tar -xzf "$WORK/tarball.tgz" -C "$WORK/tarball" --strip-components=1 "*/$TYPE_DIR/$NAME"
  rsync -a "$WORK/tarball/$TYPE_DIR/$NAME/" "$PUBLISHED/"
  [ -f "$PUBLISHED/manifest.json" ] && mv "$PUBLISHED/manifest.json" "$PUBLISHED/$MANIFEST"
  PUBLISHED_VERSION="$(jq -r '.version // empty' "$PUBLISHED/$MANIFEST" 2>/dev/null || true)"

  heading "diff: registry $COMPARE_REF (published/) -> local (staged/)"
  set +e
  (cd "$WORK" && diff -ruN published staged)
  DIFF_STATUS=$?
  set -e
  [ "$DIFF_STATUS" -eq 0 ] && echo "  (no differences)"
fi

if [ -n "$PUBLISHED_VERSION" ] && [ "$PUBLISHED_VERSION" = "$VERSION" ]; then
  if [ "$DIFF_STATUS" -eq 0 ]; then
    echo
    echo "$NAME $VERSION is already published with identical files; nothing to publish."
    [ "$DRY_RUN" -eq 1 ] || exit 0
  else
    echo
    echo "WARNING: files differ but version $VERSION is already published; bump \"version\" in $SIDECAR."
  fi
fi

read -r -a CLI_CMD <<<"$CLI"
if ! command -v "${CLI_CMD[0]}" >/dev/null 2>&1; then
  echo
  echo "publish-package: registry CLI '${CLI_CMD[0]}' not installed (bootstrap.sh installs it on a machine with the company layer)." >&2
  echo "Staged files left in $WORK" >&2
  exit 1
fi

if [ "$DRY_RUN" -eq 1 ]; then
  heading "$CLI publish --dry-run"
  (cd "$STAGE" && "${CLI_CMD[@]}" publish --dry-run --repo "$REPO")
  echo
  echo "Dry run only; nothing was published. Staged files left in $WORK"
  exit 0
fi

if [ "$ASSUME_YES" -ne 1 ]; then
  [ -t 0 ] || die "refusing to publish without a terminal; re-run with --yes to confirm"
  printf '\nPublish %s %s to %s (opens a pull request)? [y/N] ' "$NAME" "$VERSION" "$REPO"
  read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || { echo "Not published. Staged files left in $WORK"; exit 0; }
fi
heading "$CLI publish"
(cd "$STAGE" && "${CLI_CMD[@]}" publish --repo "$REPO")
