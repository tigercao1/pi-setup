#!/usr/bin/env python3
"""pi-models: the persona -> alias -> model table in <agent-dir>/models.json.

  pi-models show
  pi-models set-alias <alias> <model-id> [--provider P]   (checks models-store.json, then syncs)
  pi-models set-persona <persona> <alias|inherit>          (then syncs)
  pi-models sync     writes the lead persona's model into defaultModel/defaultProvider of
                     settings.json and settings.base.json, touching only those two keys
  pi-models check    the pi-doctor checks; exits 1 on a failure

--agent-dir D (or PI_CODING_AGENT_DIR / PI_AGENT_DIR) points at another agent directory.
"""
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pi_models as pm  # noqa: E402

SETTINGS_FILES = ("settings.json", "settings.base.json")


def die(message):
    print(f"pi-models: {message}", file=sys.stderr)
    sys.exit(1)


def read_models(base):
    path = pm.models_path(base)
    try:
        raw = pm.read_json(path)
    except FileNotFoundError:
        raw = {}
    except (OSError, ValueError) as exc:
        die(f"{path} cannot be parsed: {exc}")
    raw.setdefault("aliases", {})
    raw.setdefault("personas", {})
    return path, raw


def lead_ref(config):
    alias = config.get("personas", {}).get("lead")
    if not alias or alias == pm.INHERIT:
        return None
    ref = config.get("aliases", {}).get(alias)
    return (ref["model"], ref["provider"]) if ref else None


def cmd_show(base, _args):
    config, problem = pm.load(pm.models_path(base))
    if problem:
        print(f"warning: {problem}; showing the built-in fallback table")
    rows = [("persona", "alias", "model", "provider")]
    for persona, alias in config["personas"].items():
        ref = config["aliases"].get(alias) if alias != pm.INHERIT else None
        rows.append((persona, alias, ref["model"] if ref else "(inherit)", ref["provider"] if ref else ""))
    widths = [max(len(r[i]) for r in rows) for i in range(4)]
    for row in rows:
        print("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip())
    unprofiled = config.get("unprofiled")
    if unprofiled and unprofiled["router"] == "none":
        print(f"\nunprofiled workers (fallback: {unprofiled['reason']}): every spawn -> {unprofiled['fallback']}, no jev call")
    elif unprofiled:
        print(f"\nunprofiled workers ({unprofiled['router']}): implementation -> {unprofiled['implementation']}, "
              f"other -> {unprofiled['other']} at >= {unprofiled['minConfidence']}, otherwise {unprofiled['fallback']} "
              f"(timeout {unprofiled['timeoutMs']} ms)")
    if config.get("leadTrial"):
        print(f"lead trial arms: {', '.join(config['leadTrial'])} (settings leadTrial.models wins when set)")
    return 0


def sync(base, quiet=False):
    config, problem = pm.load(pm.models_path(base))
    if problem:
        die(f"{problem}; nothing synced")
    ref = lead_ref(config)
    if not ref:
        die('persona "lead" must name an alias; nothing synced')
    model, provider = ref

    def apply(settings):
        settings["defaultModel"] = model
        settings["defaultProvider"] = provider

    for name in SETTINGS_FILES:
        path = os.path.join(base, name)
        if not os.path.exists(path):
            print(f"  skip  {name} (missing)")
            continue
        try:
            changed = pm.update_json(path, apply)
        except (OSError, ValueError) as exc:
            die(f"{path}: {exc}")
        if changed or not quiet:
            print(f"  {'wrote' if changed else 'ok   '} {name}: defaultModel {model}, defaultProvider {provider}")
    return 0


def cmd_sync(base, _args):
    return sync(base)


def cmd_set_alias(base, args):
    path, raw = read_models(base)
    current = raw["aliases"].get(args.alias) or {}
    provider = args.provider or current.get("provider") or pm.GATEWAY
    ids = pm.store_ids(base)
    if ids is None:
        die(f"cannot read {os.path.join(base, 'models-store.json')}, so {args.model} cannot be checked")
    if args.model not in ids.get(provider, set()):
        die(f"{args.model} is not a {provider} model in models-store.json")
    raw["aliases"][args.alias] = {"model": args.model, "provider": provider}
    try:
        pm.validate(raw)
    except pm.ModelsError as exc:
        die(f"refusing to write an invalid {path}: {exc}")
    pm.write_json_atomic(path, raw)
    print(f"alias {args.alias} -> {provider} {args.model}")
    return sync(base)


def cmd_set_persona(base, args):
    path, raw = read_models(base)
    if args.alias != pm.INHERIT and args.alias not in raw["aliases"]:
        die(f'unknown alias "{args.alias}" (known: {", ".join(raw["aliases"]) or "none"}, or inherit)')
    if args.persona == "lead" and args.alias == pm.INHERIT:
        die('persona "lead" cannot inherit: settings defaultModel needs a literal model')
    raw["personas"][args.persona] = args.alias
    try:
        pm.validate(raw)
    except pm.ModelsError as exc:
        die(f"refusing to write an invalid {path}: {exc}")
    pm.write_json_atomic(path, raw)
    print(f"persona {args.persona} -> {args.alias}")
    return sync(base)


def check(base):
    results = []

    def ok(message):
        results.append(("ok", message))

    def fail(message):
        results.append(("FAIL", message))

    def warn(message):
        results.append(("warn", message))

    path = pm.models_path(base)
    config, problem = pm.load(path)
    if problem:
        fail(f"models.json: {problem}")
    else:
        ok(f"models.json parses: {len(config['aliases'])} aliases, {len(config['personas'])} personas")
        ids = pm.store_ids(base)
        if ids is None:
            warn("models-store.json unreadable, alias ids not checked (start pi once to refresh it)")
        else:
            for alias, ref in config["aliases"].items():
                if ref["model"] in ids.get(ref["provider"], set()):
                    ok(f"alias {alias}: {ref['provider']} {ref['model']} is in models-store.json")
                else:
                    fail(f"alias {alias}: {ref['provider']} {ref['model']} is not in models-store.json")
    lead = None if problem else lead_ref(config)
    if not problem and not lead:
        fail('persona "lead" does not name an alias')
    for name in SETTINGS_FILES:
        settings_path = os.path.join(base, name)
        try:
            settings = pm.read_json(settings_path)
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as exc:
            fail(f"{name} cannot be parsed: {exc}")
            continue
        if lead:
            have = (settings.get("defaultModel"), settings.get("defaultProvider"))
            if have == lead:
                ok(f"{name} defaultModel {lead[0]} matches the lead persona")
            else:
                fail(f"{name} defaultModel/defaultProvider {have[0]} / {have[1]} differ from the lead persona "
                     f"{lead[0]} / {lead[1]} (run pi-models sync)")
        profiles = ((settings.get("team") or {}).get("profiles") or {})
        pinned = sorted(n for n, p in profiles.items() if isinstance(p, dict) and p.get("model"))
        for profile in pinned:
            warn(f"{name} team.profiles.{profile}.model = {profiles[profile]['model']} overrides models.json "
                 f"(set it with pi-models set-persona instead)")
        if not pinned:
            ok(f"{name} team.profiles sets no models")
    return results


def cmd_check(base, _args):
    results = check(base)
    for level, message in results:
        print(f"  {level.ljust(4)}  {message}")
    return 1 if any(level == "FAIL" for level, _ in results) else 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="pi-models", description=__doc__.split("\n")[0])
    parser.add_argument("--agent-dir", default=None)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("show").set_defaults(func=cmd_show)
    sub.add_parser("sync").set_defaults(func=cmd_sync)
    sub.add_parser("check").set_defaults(func=cmd_check)
    alias = sub.add_parser("set-alias")
    alias.add_argument("alias")
    alias.add_argument("model")
    alias.add_argument("--provider")
    alias.set_defaults(func=cmd_set_alias)
    persona = sub.add_parser("set-persona")
    persona.add_argument("persona")
    persona.add_argument("alias")
    persona.set_defaults(func=cmd_set_persona)
    args = parser.parse_args(argv)
    base = os.path.abspath(args.agent_dir or pm.agent_dir())
    return args.func(base, args)


if __name__ == "__main__":
    sys.exit(main())
