function page(title, body) {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>${CSS}</style></head><body><main>${body}</main></body></html>\n`;
}

function timelineHtml(day) {
  const items = [];
  for (const s of day.sessions || []) for (const [a, b] of s.segments) items.push({ label: s.title || s.name, a: Date.parse(a), b: Math.max(Date.parse(b), Date.parse(a) + 5 * 60000), kind: "s" });
  const base = zonedToUtc(day.ymd, 0).getTime();
  for (const m of day.meetings || []) {
    const [hh, mm] = (m.time.match(/(\d{1,2}):(\d{2})/) || []).slice(1).map(Number);
    if (Number.isNaN(hh) || hh === undefined) continue;
    const a = base + (hh * 60 + mm) * 60000;
    items.push({ label: `📅 ${m.title}`, a, b: a + 30 * 60000, kind: "m" });
  }
  if (!items.length) return "";
  const startH = Math.min(8, ...items.map((i) => Math.floor((i.a - base) / 3600000)));
  const endH = Math.max(18, ...items.map((i) => Math.ceil((i.b - base) / 3600000)));
  const t0 = base + startH * 3600000;
  const span = (endH - startH) * 3600000;
  const pct = (t) => ((t - t0) / span) * 100;
  const rows = new Map();
  for (const i of items) (rows.get(i.label) || rows.set(i.label, []).get(i.label)).push(i);
  const axis = [];
  for (let h = startH; h <= endH; h += 2) axis.push(`<span style="left:${pct(base + h * 3600000)}%">${h}:00</span>`);
  return `<div class="tl">${[...rows.entries()].map(([label, bars]) => `<div class="row"><div class="lab" title="${esc(label)}">${esc(label)}</div><div class="track">${bars.map((i) => `<div class="bar ${i.kind}" style="left:${pct(i.a)}%;width:${Math.max(pct(i.b) - pct(i.a), 0.6)}%" title="${esc(label)} ${fmtTime(i.a)}–${fmtTime(i.b)}"></div>`).join("")}</div></div>`).join("")}<div class="axis">${axis.join("")}</div></div>`;
}

function renderDayHtml(ymd) {
  const md = readNote(ymd);
  if (!md) return `(no note for ${ymd})`;
  const dj = path.join(CONFIG.ledgerDir, ymd, "day.json");
  const day = fs.existsSync(dj) ? JSON.parse(fs.readFileSync(dj, "utf8")) : { ymd, sessions: [], meetings: [] };
  const sec = sections(md);
  const head = sec._head || "";
  const title = (head.match(/^# (.+)$/m) || [])[1] || ymd;
  const gen = (head.match(/^_(.+)_$/m) || [])[1] || "";
  const threads = (sec.Threads || "").split(/\n(?=### )/).filter((t) => t.trim().startsWith("###"));
  const prev = workingDays(addDays(ymd, -4), addDays(ymd, -1)).reverse().find((d) => readNote(d));
  const next = workingDays(addDays(ymd, 1), addDays(ymd, 4)).find((d) => readNote(d));
  const nav = [prev ? `<a href="${prev}.html">← ${prev}</a>` : "", `<a href="index.html">all days</a>`, next ? `<a href="${next}.html">${next} →</a>` : ""].filter(Boolean).join(" · ");
  const body = [
    `<h1>${esc(title)}</h1><div class="sub">${esc(gen)} · ${nav}</div>`,
    sec.Summary ? `<div class="card summary">${mdToHtml(sec.Summary)}</div>` : "",
    `<h2>Timeline (ET)</h2><div class="card">${timelineHtml(day) || "<p>No timing data; rerun pi-today for this day.</p>"}</div>`,
    `<h2>Threads</h2><div class="grid">${threads.map((t) => `<div class="card">${mdToHtml(t)}</div>`).join("")}</div>`,
    sec["Carry-over"] ? `<h2>Carry-over</h2><div class="card">${mdToHtml(sec["Carry-over"])}</div>` : "",
    sec["Not covered by summary"] ? `<h2>Not covered by summary</h2><div class="card">${mdToHtml(sec["Not covered by summary"])}</div>` : "",
    sec["Discovery warnings"] ? `<h2>Discovery warnings</h2><div class="card">${mdToHtml(sec["Discovery warnings"])}</div>` : "",
    sec.Meetings ? `<details><summary>Meetings</summary><div class="card">${mdToHtml(sec.Meetings)}</div></details>` : "",
    sec.Sessions ? `<details><summary>Sessions and exclusions</summary><div class="card">${mdToHtml(sec.Sessions)}</div></details>` : "",
  ].join("\n");
  const titled = (day.meetings || []).reduce((h, m) => h.split(`data-m="${m.slug}">meeting<`).join(`data-m="${m.slug}">📅 ${esc(m.title)}<`), body);
  const out = path.join(CONFIG.outDir, `${ymd}.html`);
  fs.writeFileSync(out, page(title, titled));
  return out;
}

function renderWeekHtml(mdFile, days) {
  const md = fs.readFileSync(mdFile, "utf8");
  const sec = sections(md);
  const head = sec._head || "";
  const title = (head.match(/^# (.+)$/m) || [])[1] || "Week";
  const post = sec.Post || "";
  const dayCards = days.map((d) => {
    const s = sections(readNote(d) || "");
    const first = (s.Summary || "").split("\n").slice(0, 2).join(" ");
    return `<div class="card"><h3><a href="${d}.html">${d}</a></h3><p>${inline(first.slice(0, 320))}${first.length > 320 ? "…" : ""}</p></div>`;
  }).join("");
  const body = [
    `<h1>${esc(title)}</h1><div class="sub">${esc((head.match(/^_(.+)_$/m) || [])[1] || "")} · <a href="index.html">all days</a></div>`,
    sec["Week in one paragraph"] ? `<div class="card summary">${mdToHtml(sec["Week in one paragraph"])}</div>` : "",
    `<h2>Days</h2><div class="days">${dayCards}</div>`,
    sec.Outcomes ? `<h2>Outcomes</h2><div class="grid">${sec.Outcomes.split(/\n(?=### )/).filter((t) => t.trim()).map((t) => `<div class="card">${mdToHtml(t)}</div>`).join("")}</div>` : "",
    sec.Decisions ? `<h2>Decisions</h2><div class="card">${mdToHtml(sec.Decisions)}</div>` : "",
    sec["Still open"] ? `<h2>Still open</h2><div class="card">${mdToHtml(sec["Still open"])}</div>` : "",
    post ? `<h2>Post (copy into Slack)</h2><div class="card post">${esc(post)}</div>` : "",
  ].join("\n");
  const out = mdFile.replace(/\.md$/, ".html");
  fs.writeFileSync(out, page(title, body));
  renderIndexHtml();
  return out;
}

function renderIndexHtml() {
  const files = fs.readdirSync(CONFIG.outDir);
  const days = files.filter((x) => /^\d{4}-\d{2}-\d{2}\.md$/.test(x)).map((x) => x.slice(0, 10)).sort().reverse();
  const weeks = files.filter((x) => /^week-.*\.md$/.test(x)).sort().reverse();
  const body = [
    `<h1>Daily work notes</h1><div class="sub">${days.length} days</div>`,
    weeks.length ? `<h2>Weeks</h2><div class="card"><ul>${weeks.map((w) => `<li><a href="${w.replace(/\.md$/, ".html")}">${esc(w.replace(/^week-|\.md$/g, "").replace("_", " → "))}</a></li>`).join("")}</ul></div>` : "",
    `<h2>Days</h2><div class="days">${days.map((d) => {
      const s = sections(readNote(d) || "");
      const first = (s.Summary || "").split("\n")[0] || "";
      return `<div class="card"><h3><a href="${d}.html">${d}</a></h3><p>${inline(first.slice(0, 220))}${first.length > 220 ? "…" : ""}</p></div>`;
    }).join("")}</div>`,
  ].join("\n");
  const out = path.join(CONFIG.outDir, "index.html");
  fs.writeFileSync(out, page("Daily work notes", body));
  return out;
}

main().catch((e) => { console.error(e.stack || e.message); process.exit(1); });
