  "type": "module",
  "keywords": ["pi-package", "orchestration", "multi-agent", "sessions", "worktree", "notifications"],
  "license": "UNLICENSED",
  "pi": {
    "extensions": [
      "./extensions/agent-orchestrator/index.ts",
      "./extensions/session-bus/index.ts",
      "./extensions/session-fork/index.ts",
      "./extensions/tab-title/index.ts",
      "./extensions/no-sleep-while-working/index.ts",
      "./extensions/context-watcher/index.ts",
      "./extensions/lead-output-cap/index.ts",
      "./extensions/worktree/index.ts",
      "./extensions/notify/index.ts",
      "./extensions/jev/index.ts"
    ],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
