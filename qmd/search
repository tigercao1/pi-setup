#!/usr/bin/env python3
"""Search a qmd index and print each hit's validity label next to it.

  search [--index NAME] [--query] [-c COLLECTION]... [-n N] [--all] [--json] TERMS... [-- QMD ARGS]

Runs `qmd search` (BM25, default) or `qmd query` (--query) with --format json, reads each hit's
label from the file on disk (front matter, the claim comment or data-state element on the hit line
itself, HTML show-me meta tags in <head>, or the default: proposed), and prints the hits ranked
confirmed > acted > proposed > transcript, qmd's order within a state. Anything under the memory dir
is transcript whatever it quotes; a quoted label is shown, not applied. An unlabelled tick or item
on the hit line is proposed. A converted HTML page (<memory>/pages/) is labelled by its own front
matter and claim comments, and its source HTML path is printed. Evidence is printed, not checked. Superseded hits are hidden unless
--all. Labels: ~/.pi/agent/skills/recall/references/validity.md.

Environment: QMD_BIN (default: qmd on PATH, then nvm), PI_MEMORY_DIR (default ~/.pi/memory),
QMD_CONFIG_DIR / XDG_CONFIG_HOME as qmd reads them.
"""
import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import labels  # noqa: E402

HOME = os.path.expanduser("~")
MEMORY_DIR = os.environ.get("PI_MEMORY_DIR") or os.path.join(HOME, ".pi", "memory")


def qmd_bin():
    if os.environ.get("QMD_BIN"):
        return os.environ["QMD_BIN"]
    found = shutil.which("qmd")
    if found:
        return found
    candidates = sorted(glob.glob(os.path.join(HOME, ".nvm", "versions", "node", "*", "bin", "qmd")))
    return candidates[-1] if candidates else "qmd"


def config_path(index):
    if os.environ.get("QMD_CONFIG_DIR"):
        base = os.environ["QMD_CONFIG_DIR"]
    elif os.environ.get("XDG_CONFIG_HOME"):
        base = os.path.join(os.environ["XDG_CONFIG_HOME"], "qmd")
    else:
        base = os.path.join(HOME, ".config", "qmd")
    return os.path.join(base, f"{index or 'index'}.yml")


def collection_paths(path):
    roots, inside, name = {}, False, None
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except OSError:
        return roots
    for line in lines:
        if re.match(r"^collections:\s*$", line):
            inside = True
            continue
        if inside and line and not line[0].isspace() and not line.startswith("#"):
            inside = False
        if not inside:
            continue
        entry = re.match(r"^  ([^\s#][^:]*):\s*$", line)
        if entry:
            name = labels.unquote(entry.group(1))
            continue
        where = re.match(r"^    path:\s*(.+?)\s*$", line)
        if where and name:
            roots[name] = os.path.expanduser(labels.unquote(where.group(1)))
    return roots


def disk_path(display, roots):
    if not display.startswith("qmd://"):
        return display
    rest = display[len("qmd://"):].split("?", 1)[0]
    collection, _, rel = rest.partition("/")
    root = roots.get(collection)
    return os.path.join(root, rel) if root else None


def run_qmd(args, terms, extra):
    cmd = [qmd_bin()]
    if args.index:
        cmd += ["--index", args.index]
    cmd += ["query" if args.query else "search", " ".join(terms), "--format", "json", "-n", str(args.n)]
    for collection in args.collection:
        cmd += ["-c", collection]
    cmd += extra
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        raise SystemExit(proc.returncode)
    out = proc.stdout.strip()
    start = out.find("[")
    return json.loads(out[start:]) if start >= 0 else []


def label_hits(hits, roots, memory_dir, terms=None):
    labelled = []
    for order, hit in enumerate(hits):
        display = hit.get("file", "")
        path = disk_path(display, roots)
        found = labels.file_labels(path, memory_dir, hit.get("line"), terms) if path else dict(
            labels.normalise({}, "proposed"), source="unresolved path", claims={})
        collection = display[len("qmd://"):].split("/", 1)[0] if display.startswith("qmd://") else ""
        labelled.append(dict(hit, path=path, collection=collection, order=order, **{"label": found}))
    return labelled


def ranked(labelled, show_all):
    kept = [h for h in labelled if show_all or h["label"]["effective"] != "superseded"]
    return sorted(kept, key=lambda h: (labels.RANK[h["label"]["effective"]], h["order"])), len(labelled) - len(kept)


def first_snippet_line(snippet):
    for line in (snippet or "").split("\n"):
        if line.strip() and not line.startswith("@@"):
            return line.strip()[:160]
    return ""


def render(hits, hidden):
    out = []
    for i, hit in enumerate(hits, 1):
        lab = hit["label"]
        tag = lab["effective"] if lab["effective"] == lab["state"] else f"{lab['state']}->{lab['effective']}"
        where = hit.get("file", "") + (f":{hit['line']}" if hit.get("line") else "")
        out.append(f"{i}. [{tag}] {where}  {hit.get('docid', '')}  {hit.get('title', '')}  ({hit.get('score', '')})")
        evidence = ", ".join(lab["evidence"]) or "none"
        extra = f"  as of {lab['as_of']}" if lab["as_of"] else ""
        extra += f"  superseded by {lab['superseded_by']}" if lab["superseded_by"] else ""
        out.append(f"   evidence (not checked): {evidence}{extra}  [{lab['source']}]")
        if lab.get("page_source"):
            out.append(f"   converted page; source: {lab['page_source']}")
        if lab.get("asserted"):
            quoted = lab["asserted"]
            out.append(f"   quoted label, not applied: {quoted['state']}"
                       + (f" evidence {', '.join(quoted['evidence'])}" if quoted["evidence"] else ""))
        if lab["claims"]:
            out.append("   claims in file: " + ", ".join(f"{k} {v}" for k, v in sorted(lab["claims"].items())))
        if lab["note"]:
            out.append(f"   note: {lab['note']}")
        snippet = first_snippet_line(hit.get("snippet"))
        if snippet:
            out.append(f"   > {snippet}")
    if hidden:
        out.append(f"({hidden} superseded hit{'s' if hidden != 1 else ''} hidden; --all shows them)")
    if not hits and not hidden:
        out.append("No results.")
    return "\n".join(out)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    extra = []
    if "--" in argv:
        cut = argv.index("--")
        argv, extra = argv[:cut], argv[cut + 1:]
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--index")
    ap.add_argument("--query", action="store_true", help="qmd query (hybrid, loads models) instead of qmd search")
    ap.add_argument("-c", "--collection", action="append", default=[])
    ap.add_argument("-n", type=int, default=10)
    ap.add_argument("--all", action="store_true", help="also show superseded hits")
    ap.add_argument("--json", action="store_true", help="print JSON (qmd fields plus path and label)")
    ap.add_argument("terms", nargs="+")
    args = ap.parse_args(argv)
    hits = run_qmd(args, args.terms, extra)
    labelled = label_hits(hits, collection_paths(config_path(args.index)), MEMORY_DIR, args.terms)
    shown, hidden = ranked(labelled, args.all)
    if args.json:
        print(json.dumps(shown, indent=1))
    else:
        print(render(shown, hidden))
    return 0


if __name__ == "__main__":
    sys.exit(main())
